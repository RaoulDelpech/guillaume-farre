# Configuration Stripe
# Récupérez vos clés sur https://dashboard.stripe.com/apikeys
# Pour tester : utilisez les clés de test (commençant par sk_test_)
# Pour production : utilisez les clés de production (commençant par sk_live_)

STRIPE_SECRET_KEY=sk_test_VOTRE_CLE_SECRETE_ICI
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_VOTRE_CLE_PUBLIQUE_ICI

# Webhook Stripe (pour envoi automatique à WhiteWall après paiement)
# Créez un webhook sur https://dashboard.stripe.com/webhooks
# URL du webhook : https://guillaumefarre.com/api/webhooks/stripe
# Événements à écouter : checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_SECRET_WEBHOOK_ICI

# URL du site (production)
NEXT_PUBLIC_SITE_URL=https://guillaumefarre.com

# Mot de passe admin (CHANGEZ-LE EN PRODUCTION!)
ADMIN_PASSWORD=votre_mot_de_passe_securise

# Configuration WhiteWall (Service d'impression professionnel)
# Obtenez vos clés sur https://www.whitewall.com/fr/partners
WHITEWALL_API_KEY=votre_cle_api_whitewall
WHITEWALL_PARTNER_ID=votre_id_partenaire_whitewall
WHITEWALL_API_URL=https://api.whitewall.com/v1
WHITEWALL_TEST_MODE=true

# Note : Copiez ce fichier en .env.local et remplissez les valeurs

# Configuration Stripe
# Récupérez vos clés sur https://dashboard.stripe.com/apikeys

# IMPORTANT : Pour que les paiements fonctionnent, vous DEVEZ :
# 1. Créer un compte Stripe sur https://dashboard.stripe.com
# 2. Copier vos clés API (test ou production)
# 3. Copier ce fichier vers .env.local et remplacer les valeurs ci-dessous

# Clés de TEST (commençant par sk_test_ et pk_test_)
# À utiliser en développement uniquement
STRIPE_SECRET_KEY=sk_test_VOTRE_CLE_SECRETE_ICI
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_VOTRE_CLE_PUBLIQUE_ICI

# Webhook secret (pour recevoir les confirmations de paiement)
# Pour le générer :
# 1. Allez sur https://dashboard.stripe.com/webhooks
# 2. Créez un endpoint pointant vers : https://guillaumefarre.com/api/webhooks/stripe
# 3. Sélectionnez l'événement : checkout.session.completed
# 4. Copiez le "Signing secret"
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_WEBHOOK_SECRET_ICI

# URL du site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mot de passe admin
ADMIN_PASSWORD=Guillaumedinoman2025!

# WhiteWall (optionnel - pour impression automatique)
WHITEWALL_API_KEY=votre_cle_api_whitewall
WHITEWALL_PARTNER_ID=votre_id_partenaire_whitewall
WHITEWALL_API_URL=https://api.whitewall.com/v1
WHITEWALL_TEST_MODE=true

# PRODUCTION :
# Pour passer en production, remplacez par vos clés LIVE (sk_live_ et pk_live_)
# ET changez NEXT_PUBLIC_SITE_URL=https://guillaumefarre.com

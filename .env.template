# Configuration Stripe
# Récupérez vos clés sur https://dashboard.stripe.com/apikeys
# Pour tester : utilisez les clés de test (commençant par sk_test_)
# Pour production : utilisez les clés de production (commençant par sk_live_)

STRIPE_SECRET_KEY=sk_live_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here

# URL du site (local pour développement, production pour déploiement)
NEXT_PUBLIC_SITE_URL=https://guillaumefarre.com

# Mot de passe admin (CHANGEZ-LE EN PRODUCTION!)
ADMIN_PASSWORD=your_secure_admin_password_here

# Configuration WhiteWall (Service d'impression professionnel)
# Obtenez vos clés sur https://www.whitewall.com/fr/partners
# NOTE: WhiteWall remplacé par Gelato (voir ci-dessous)
WHITEWALL_API_KEY=your_whitewall_api_key
WHITEWALL_PARTNER_ID=your_whitewall_partner_id
WHITEWALL_API_URL=https://api.whitewall.com/v1
WHITEWALL_TEST_MODE=true

# Configuration Gelato (Service d'impression - DÉCISION 2025-11-07)
# Production locale France, Fine Art Giclee 12 couleurs
# Obtenez votre clé sur https://dashboard.gelato.com/
# Guide setup: GELATO_VALIDATION_GUIDE.md
GELATO_API_KEY=your_gelato_api_key_here
GELATO_WEBHOOK_SECRET=your_gelato_webhook_secret_here
GELATO_API_URL=https://order.gelatoapis.com
GELATO_TEST_MODE=true

# Configuration DeepL (Traductions professionnelles)
# Obtenez votre clé sur https://www.deepl.com/pro-api
# Plan gratuit: 500k caractères/mois
# Guide setup: DEEPL_SETUP.md
DEEPL_API_KEY=your_deepl_api_key_here
DEEPL_API_URL=https://api-free.deepl.com/v2

# Configuration Anthropic Claude (Descriptions photos IA)
# Obtenez votre clé sur https://console.anthropic.com/
# Modèle recommandé: Claude 3.5 Haiku (rapide + économique)
# Guide setup: ANTHROPIC_VISION_SETUP.md
ANTHROPIC_API_KEY=your_anthropic_api_key_here


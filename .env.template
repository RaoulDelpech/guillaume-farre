# Configuration Stripe
# Récupérez vos clés sur https://dashboard.stripe.com/apikeys
# Pour tester : utilisez les clés de test (commençant par sk_test_)
# Pour production : utilisez les clés de production (commençant par sk_live_)

STRIPE_SECRET_KEY=sk_live_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here

# URL du site (local pour développement, production pour déploiement)
NEXT_PUBLIC_SITE_URL=https://guillaumefarre.com

# Mot de passe admin (CHANGEZ-LE EN PRODUCTION!)
ADMIN_PASSWORD=your_secure_admin_password_here

# Configuration WhiteWall (Service d'impression professionnel)
# Obtenez vos clés sur https://www.whitewall.com/fr/partners
WHITEWALL_API_KEY=your_whitewall_api_key
WHITEWALL_PARTNER_ID=your_whitewall_partner_id
WHITEWALL_API_URL=https://api.whitewall.com/v1
WHITEWALL_TEST_MODE=true


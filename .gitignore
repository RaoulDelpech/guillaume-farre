# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.env.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bun
bun.lockb

# npm (we use bun exclusively as of 2026-04-11 supply chain mitigation:
# package-lock.json pulls the suspicious eslint-import-resolver-typescript@3.10.1
# -> unrs-resolver@1.11.1 postinstall chain on Linux x64 deploy targets.
# bun.lock pins the safe 3.8.3 and bun does not run untrusted postinstall scripts.
# Do NOT commit package-lock.json.)
package-lock.json

# uploads (keep folder but ignore uploaded files)
/public/uploads/*
!/public/uploads/.gitkeep

# photos à trier (keep folder but ignore uploaded files)
/public/images/works/a-trier/*
!/public/images/works/a-trier/.gitkeep

# orders data (contains customer information)
/data/orders.json

# Implementation reports (auto-generated, not for git)
*_IMPLEMENTATION_REPORT.md
*_SETUP.md
*_FIXES_*.md
*_AUDIT_*.md

# Generated docs (PDFs, scripts, market reports)
docs/*.pdf
docs/generate_*.py
RAPPORT_MARCHE_ART_*.md
ANALYSE_STRATEGIQUE_*.md
test-mobile.sh

# Reservations data (contains client information)
/data/reservations.json

# Data backups (generated by scripts/backup-data.ts, written by CI/CD on VPS)
/data/backups/

# Concurrent locks (created by lib/locks.ts at runtime)
/data/locks/

# Local verification artifacts (screenshots, traces)
/.tmp/

# Sources HR toiles (backups en local sur ~/Desktop/Toiles Guillaumes)
public/images/works/toiles/

# Backup originaux toiles (avant crop)
public/images/toiles/_backup_originals/
